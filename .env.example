# Variables de entorno (Railway → Variables). NO commitear el .env real.

# Postgres (misma base de Railway)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PUERTO/railway
# PGSSL=true

# Zona horaria para agrupar por día/hora (por defecto America/Santo_Domingo)
TZ_DISPLAY=America/Santo_Domingo

# Cotizaciones — viven en una base MSSQL aparte (site4now). Conexión propia.
# ⚠️ Los valores reales van en las Variables de Railway, NO en el repo.
MSSQL_SERVER=sql5045.site4now.net
MSSQL_DATABASE=DB_A61822_simJH
MSSQL_USER=<usuario>
MSSQL_PASSWORD=<clave>
MSSQL_PORT=1433
MSSQL_ENCRYPT=false
# tabla/columnas (por defecto: iCotizacionesWebIA / FechaRegistro / total)
# MSSQL_QUOTES_TABLE=iCotizacionesWebIA
# MSSQL_QUOTES_DATE=FechaRegistro
# MSSQL_QUOTES_AMOUNT=total

# Webhook de n8n para el tablero de oportunidades. n8n debe mandar este valor
# en el header  X-Api-Key  al llamar POST /api/hooks/opportunities.
N8N_API_KEY=pon-aqui-una-clave-larga-y-secreta

# ── Eficiencia de Camila (tarjeta del Resumen) ───────────────────────────────
# Llama a la API PÚBLICA de n8n para contar ejecuciones y fallas de los flujos
# de Camila. La API key se queda en el servidor (no sale al navegador).
# N8N_API_URL: base de tu n8n (sin barra final).
# N8N_API_TOKEN: token de la API pública de n8n (Settings -> n8n API). Distinto
#   de N8N_API_KEY (ese es el secreto de webhooks ENTRANTES). Idealmente de solo
#   lectura; se puede revocar cuando quieras.
# N8N_API_URL=https://server.neboaiconsulting.com
# N8N_API_TOKEN=eyJhbGciOiJIUzI1NiI... (token largo de n8n)
# Opcionales (tienen buenos defaults):
# CAMILA_BACKFILL_DAYS=120   # histórico que mantiene el espejo en memoria
# CAMILA_SYNC_MS=300000      # cada cuánto sincroniza lo nuevo (5 min)
# CAMILA_MAX_PAGES=600       # tope de seguridad de paginación por flujo
# Fallos por servicios externos que NO cuentan como error de Camila: si una
# ejecución falla por un error de estos hosts, se excluye del % (host,host).
# CAMILA_EXT_HOSTS=app.swordaisolutions.com,whatsapp.neboaiconsulting.com
# CAMILA_EXT_BUDGET=250      # fallidas cuyo detalle se inspecciona por ciclo

# PDFs de las cotizaciones: viven en Supabase Storage (bucket PÚBLICO).
# La URL se arma como {SUPABASE_URL}/storage/v1/object/public/{bucket}/{archivo}.
# {n} se sustituye por el nº de cotización (nfactura).
SUPABASE_QUOTES_BUCKET=Lucas
SUPABASE_QUOTES_PATTERN=cotizacion_{n}.pdf
# Solo si los PDFs viven en un proyecto de Supabase DISTINTO al del login:
# SUPABASE_STORAGE_URL=https://bewpkmgcnzukyouplbwm.supabase.co

# Coste por mensaje (la base no lo guarda: se aplica esta tarifa).
MSG_COST_OUT=0.03          # coste por mensaje saliente
MSG_COST_IN=0              # coste por mensaje entrante
MSG_COST_CURRENCY=USD

# Llamadas del agente de voz. n8n las envía a POST /api/calls/hook con el
# mismo header X-Api-Key (N8N_API_KEY). Moneda para mostrar el coste:
CALL_COST_CURRENCY=USD

# Ajustes -> Agente de llamadas. El panel proxea el servicio de phone-switch
# para que la API key NO salga al navegador. Los valores reales van en Railway.
AGENT_API_BASE=https://app.swordaisolutions.com
AGENT_CLIENT_ID=16
AGENT_API_KEY=<la-api-key-de-phone-switch>

# PORT=8080

# CORS. La app nativa (capacitor://localhost, https://localhost) y localhost
# están permitidos siempre. La versión web (PWA) se acepta desde cualquier
# subdominio propio por https; solo hay que tocar esto si cambia el dominio.
# CORS_DOMAIN=neboaiconsulting.com
# CORS_EXTRA=https://otro-origen.com,https://y-otro.com
